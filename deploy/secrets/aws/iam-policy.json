{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadChronicleSecretsOnly",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue", "secretsmanager:DescribeSecret"],
      "Resource": [
        "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:chronicle/config-*",
        "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:chronicle/postgres-*"
      ]
    }
  ]
}
