# Chronicle configuration. Copy to .env (git-ignored); both files list the same
# keys in the same order. Every value here is the default the code uses when
# the variable is unset; the comment above a key says when to change it.
# Nothing loads this file automatically: `set -a; source .env; set +a` before
# `go run ./cmd/collector`. Keep values with braces or quotes single-quoted.

# ----------------------------------------------------------------- connections
# Local default shown (kind's password, from scripts/setup.sh). In the cluster:
# postgres-postgresql.chronicle.svc.cluster.local:5432. Locally:
# kubectl -n chronicle port-forward svc/postgres-postgresql 5433:5432
POSTGRES_URL=postgres://postgres:postgres@localhost:5433/postgres?sslmode=disable
# kind maps Prometheus to localhost:9090.
PROMETHEUS_URL=http://localhost:9090
# kubectl -n monitoring port-forward svc/loki 3100:3100
LOKI_URL=http://localhost:3100
# Default reads every namespace; the shipped manifest uses '{namespace="default"}'
# so control-plane chatter does not drown application errors.
LOKI_QUERY='{namespace=~".+"}'
# Empty: events are written straight to PostgreSQL. For Kafka, localhost:9092
# with kubectl -n chronicle port-forward svc/kafka 9092:9092
KAFKA_BROKERS=
KAFKA_TOPIC=chronicle.events
KAFKA_GROUP=chronicle-writer
# Empty: no recent-event cache. For Redis, localhost:6379 with
# kubectl -n chronicle port-forward svc/redis 6379:6379
REDIS_ADDR=
REDIS_PASSWORD=
# Namespace of Chronicle's own checkpoint ConfigMap.
CHRONICLE_NAMESPACE=chronicle
# Leader election Lease; POD_NAME empty means the hostname is the identity.
LEADER_ELECTION_NAMESPACE=chronicle
LEADER_ELECTION_NAME=chronicle-leader
POD_NAME=
# Empty: the console embedded in the binary; set a directory to serve from disk.
CHRONICLE_UI_DIR=

# ------------------------------------------------------------------------- RCA
# Empty: deterministic narrative, no LLM call. Key from console.groq.com.
RCA_API_KEY=
RCA_API_URL=https://api.groq.com/openai/v1/chat/completions
RCA_MODEL=llama-3.1-8b-instant
RCA_MAX_HOPS=8
# Time-decay e-folds across a symptom's lookback window.
RCA_DECAY_DIVISOR=3

# ------------------------------------------- collectors (each off while empty)
# Fine-grained token, Contents: read-only, for the repo below.
GITHUB_TOKEN=
GITHUB_OWNER=Halcyonic-01
GITHUB_REPO=Chronicle
GITHUB_POLL_INTERVAL=30s
ARGOCD_URL=
ARGOCD_TOKEN=
ARGOCD_POLL_INTERVAL=30s
TERRAFORM_URL=
TERRAFORM_TOKEN=
TERRAFORM_ORG=
TERRAFORM_POLL_INTERVAL=30s

# ------------------------------------------------------------------ API access
# Empty: anything that reaches the API can read it. Set before exposing it
# (openssl rand -hex 32).
CHRONICLE_API_TOKEN=
# Empty: no CORS header; the console is same-origin.
CHRONICLE_ALLOWED_ORIGIN=

# ------------------------------------------------ approver sign-in (OIDC)
# Empty: OIDC off, approvals use HEAL_APPROVAL_TOKEN. With an issuer set,
# OIDC_CLIENT_ID and one of the allowlists are required or Chronicle will not
# start. Test Keycloak: http://keycloak.localhost:8180/realms/chronicle,
# client chronicle, group chronicle-approvers.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_ALLOWED_GROUPS=
OIDC_ALLOWED_EMAILS=
OIDC_GROUPS_CLAIM=groups
OIDC_MAX_TOKEN_AGE=1h
# Drop groups if the provider rejects that scope.
OIDC_SCOPES=openid,email,profile,groups
# Shared approval token, used only while OIDC_ISSUER_URL is empty. Empty: nothing
# can be approved (openssl rand -hex 32).
HEAL_APPROVAL_TOKEN=

# --------------------------------------------------------------------- healing
# Dry-run unless live is true and the kill switch is false.
HEAL_LIVE_ENABLED=false
HEAL_KILL_SWITCH=true
# Empty allowlists: nothing may execute. The shipped manifest allows
# namespace default, action restart_pod, target default/redis.
HEAL_ALLOWED_NAMESPACES=
HEAL_ALLOWED_ACTIONS=
HEAL_ALLOWED_TARGETS=
HEAL_ACTION_TIMEOUT=30s
HEAL_VERIFY_TIMEOUT=3m
HEAL_APPROVAL_TTL=30m
HEAL_MAX_EXECUTIONS_PER_HOUR=3
HEAL_TARGET_COOLDOWN=30m
# How long a revision must have run without a recorded failure before a rollback
# may return to it; if the previous one did not, an older verified one is named.
HEAL_ROLLBACK_MIN_HEALTHY=30m
# restart_pod is proposal-only until this is true, after the restart path has
# passed safety testing. A pod is restarted only once it has been unready for
# HEAL_RESTART_UNREADY_FOR and nothing restarted in the last HEAL_RESTART_QUIET.
HEAL_RESTART_EXECUTION_ENABLED=false
HEAL_RESTART_UNREADY_FOR=5m
HEAL_RESTART_QUIET=10m
# Empty: the first decision Chronicle records (RFC 3339 to override).
HEAL_OBSERVATION_STARTED_AT=
# Autonomy needs judged decisions, not just elapsed time. Unknown outcomes are
# never credited toward these.
HEAL_MIN_DECISIVE_DECISIONS=20
HEAL_MIN_PRECISION=0.80
# Empty: the built-in rules. To override, a single-quoted JSON list.
HEAL_RULES=
# Empty: no Slack notifications.
SLACK_WEBHOOK_URL=
# After a successful action, how long the alert may take to start clearing and
# how long it must then stay clear. Only a critical symptom in "production"
# pages (PAGER_WEBHOOK_URL, empty: nothing is sent); any failure notifies Slack.
SYMPTOM_IMPROVE_WITHIN=2m
SYMPTOM_HOLD=5m
CHRONICLE_ENVIRONMENT=
PAGER_WEBHOOK_URL=

# ------------------------------------------------------------------ tests only
# CHRONICLE_TEST_POSTGRES_URL=postgres://postgres@localhost:55432/chronicle_test?sslmode=disable
# HEAL_TEST_KUBE_CONTEXT=kind-kyverno-test
