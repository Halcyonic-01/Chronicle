# Chronicle configuration. Copy to .env (git-ignored) and fill in the blanks.
# Nothing loads this file automatically: `set -a; source .env; set +a` before
# `go run ./cmd/collector`. Values with braces or quotes must stay single-quoted.
# Inside the cluster, secrets come from the chronicle-config Secret instead.

# --- Connections (local run against the kind cluster, through port-forwards) ---
# kubectl -n chronicle port-forward svc/postgres-postgresql 5433:5432
POSTGRES_URL=postgres://postgres:CHANGE_ME@localhost:5433/postgres?sslmode=disable
# kind maps Prometheus to localhost:9090 already
PROMETHEUS_URL=http://localhost:9090
# kubectl -n monitoring port-forward svc/loki 3100:3100
LOKI_URL=http://localhost:3100
LOKI_QUERY='{namespace="default"}'
# kubectl -n chronicle port-forward svc/kafka 9092:9092 (unset: write straight to PostgreSQL)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=chronicle.events
KAFKA_GROUP=chronicle-writer
# kubectl -n chronicle port-forward svc/redis 6379:6379
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
# Namespace for Chronicle's own Lease and checkpoint ConfigMap
CHRONICLE_NAMESPACE=chronicle
LEADER_ELECTION_NAMESPACE=chronicle
LEADER_ELECTION_NAME=chronicle-leader
# Serve the console from disk instead of the embedded copy (empty: embedded)
CHRONICLE_UI_DIR=

# --- RCA narrator (optional; without a key the narrative is deterministic) ---
RCA_API_KEY=
RCA_API_URL=https://api.groq.com/openai/v1/chat/completions
RCA_MODEL=llama-3.1-8b-instant
RCA_MAX_HOPS=8
# Empty: the built-in decay
RCA_DECAY_DIVISOR=

# --- Optional collectors (each is skipped while its URL or token is empty) ---
GITHUB_TOKEN=
GITHUB_OWNER=Halcyonic-01
GITHUB_REPO=Chronicle
GITHUB_POLL_INTERVAL=30s
ARGOCD_URL=
ARGOCD_TOKEN=
ARGOCD_POLL_INTERVAL=30s
TERRAFORM_URL=
TERRAFORM_TOKEN=
TERRAFORM_ORG=
TERRAFORM_POLL_INTERVAL=30s

# --- API access ---
# Empty: anything that reaches the API can read it. Set it whenever exposed.
CHRONICLE_API_TOKEN=
# Empty: no CORS header (the console is same-origin)
CHRONICLE_ALLOWED_ORIGIN=

# --- Approver sign-in (OIDC). Empty issuer: the shared token below is used ---
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=chronicle
OIDC_ALLOWED_GROUPS=chronicle-approvers
OIDC_ALLOWED_EMAILS=
OIDC_GROUPS_CLAIM=groups
OIDC_MAX_TOKEN_AGE=1h
OIDC_SCOPES=openid,email,profile
# Shared approval token, ignored once OIDC_ISSUER_URL is set
HEAL_APPROVAL_TOKEN=

# --- Healing (dry-run unless both of the first two say otherwise) ---
HEAL_LIVE_ENABLED=false
HEAL_KILL_SWITCH=true
HEAL_ALLOWED_NAMESPACES=default
HEAL_ALLOWED_ACTIONS=restart_pod
HEAL_ALLOWED_TARGETS=default/redis
HEAL_ACTION_TIMEOUT=30s
HEAL_VERIFY_TIMEOUT=3m
HEAL_APPROVAL_TTL=30m
HEAL_MAX_EXECUTIONS_PER_HOUR=3
HEAL_TARGET_COOLDOWN=30m
# Empty: the first decision Chronicle records
HEAL_OBSERVATION_STARTED_AT=
# Autonomy needs judged decisions, not just elapsed time. Unknown outcomes are
# never credited toward these.
HEAL_MIN_DECISIVE_DECISIONS=20
HEAL_MIN_PRECISION=0.80
# Empty: the built-in rules (JSON, single-quoted, to override)
HEAL_RULES=
SLACK_WEBHOOK_URL=

# --- Tests only (leave commented for normal runs) ---
# CHRONICLE_TEST_POSTGRES_URL=postgres://postgres@localhost:55432/chronicle_test?sslmode=disable
# HEAL_TEST_KUBE_CONTEXT=kind-kyverno-test
